generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  googleId  String?  @unique
  name      String?
  avatar    String?
  coins     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports       Report[]
  likes         Like[]
  confirms      Confirm[]
  comments      Comment[]
  replies       Reply[]
  commentLikes  CommentLike[]
  replyLikes    ReplyLike[]
  contentReports ContentReport[]

  @@map("users")
}

model Report {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(80)
  description String   @db.Text
  imageUrl    String
  cloudinaryId String?
  category    Category
  city        String   @db.VarChar(100)
  area        String   @db.VarChar(100)
  lat         Float?
  lng         Float?
  reportDate  DateTime
  authorName  String?  @db.VarChar(100)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    Like[]
  confirms Confirm[]
  comments Comment[]

  @@index([category])
  @@index([city])
  @@index([createdAt])
  @@index([userId])
  @@map("reports")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  reportId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([userId, reportId])
  @@map("likes")
}

model Confirm {
  id        String   @id @default(uuid())
  sessionId String?
  userId    String?
  reportId  String
  createdAt DateTime @default(now())

  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([userId, reportId])
  @@index([sessionId, reportId])
  @@map("confirms")
}

enum Category {
  VEHICULAR
  INDUSTRIAL
  CONSTRUCTION_DUST
  FOREST_FIRE_CROP_BURNING
  GARBAGE_BURNING
  WATER_POLLUTION
  PLASTIC_WASTE
  OTHER
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  reportId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   Reply[]
  likes     CommentLike[]
  
  @@index([reportId])
  @@index([userId])
  @@map("comments")
}

model Reply {
  id        String   @id @default(uuid())
  content   String   @db.Text
  commentId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comment   Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     ReplyLike[]

  @@index([commentId])
  @@index([userId])
  @@map("replies")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  isDislike Boolean  @default(false)
  createdAt DateTime @default(now())

  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model ReplyLike {
  id        String   @id @default(uuid())
  replyId   String
  userId    String
  isDislike Boolean  @default(false)
  createdAt DateTime @default(now())

  reply     Reply   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@map("reply_likes")
}

model ContentReport {
  id        String   @id @default(uuid())
  reason    String
  details   String?  @db.Text
  targetType String   // "REPORT", "COMMENT", "REPLY"
  targetId  String
  reporterId String
  createdAt DateTime @default(now())

  reporter  User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("content_reports")
}
